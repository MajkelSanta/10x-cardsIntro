---
import Layout from "@/layouts/Layout.astro";
import { GenerateForm } from "@/components/generate/GenerateForm";
---

<Layout title="Generuj fiszki">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Generuj fiszki
      </h1>
      <GenerateForm client:load />
    </div>
  </div>
</Layout>
